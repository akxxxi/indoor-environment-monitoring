# 复制为 .env；dev/start/queue 自动读取。已有系统环境变量优先。
MQTT_URL=mqtt://127.0.0.1:1883
DEVICE_ID=classroom-001-node-001
ROOM_ID=classroom-001
UPLOAD_INTERVAL_MS=2000
SIMULATION_SEED=20261016
SIMULATION_SCENARIO=normal
# normal | co2_high | dust_high | demo；demo 每 40 次采样循环，默认 80 秒
# 随机种子仅固定测量趋势，boot_id 与 sampled_at 始终来自实际运行。
# 相对路径始终以 simulator 项目目录解析；同一数据库只运行一个节点进程。
QUEUE_DB_PATH=./data/outbox.sqlite
QUEUE_MAX_RECORDS=43200
ACK_TIMEOUT_MS=10000
RETRY_BASE_MS=1000
MQTT_RECONNECT_MS=2000
