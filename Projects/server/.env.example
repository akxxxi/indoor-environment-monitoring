# 复制为 .env 后由 dev/start 读取；默认仅监听本机
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# 相对路径统一以 server 项目目录解析
SQLITE_PATH=./data/environment.sqlite
DEFAULT_ROOM_ID=classroom-001
DEFAULT_DEVICE_ID=classroom-001-node-001
MQTT_MAX_PAYLOAD_BYTES=1024
DEVICE_STALE_AFTER_MS=10000
SSE_HEARTBEAT_MS=15000
CORS_ORIGIN=http://127.0.0.1:5173
