{
  "name": "@envmon/server",
  "version": "0.1.0",
  "private": true,
  "description": "教室环境监测本地 MQTT 与数据 API 服务",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify:mqtt": "node scripts/verify-mqtt.js"
  },
  "dependencies": {
    "aedes": "1.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "mqtt": "5.16.1"
  }
}
